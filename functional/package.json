{
  "name": "z-functional",
  "version": "0.1.0",
  "description": "Tiny, dependency-free TypeScript library of curried functional helpers",
  "scripts": {
    "test": "node --test \"*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "author": "Zachary Lysobey <zach@lysobey.com> (https://github.com/zachlysobey)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zachlysobey/z-megarepo.git",
    "directory": "functional"
  },
  "files": [
    "dist"
  ]
}
